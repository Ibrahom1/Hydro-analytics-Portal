FROM docker.io/library/python:3.11-slim-bookworm

# Switch Debian mirror to HTTPS to prevent HTTP 403 Forbidden from CDN
RUN (sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true) && \
    (sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list 2>/dev/null || true)

# System dependencies for pdfplumber, playwright/chromium, sqlite3, git, cron
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    cron \
    sqlite3 \
    libmagic1 \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install all Python dependencies from both requirements files + extras
COPY backend/requirements.txt /tmp/backend-requirements.txt
COPY gis_uploader_backend/requirements.txt /tmp/gis-requirements.txt
RUN pip install --no-cache-dir \
    -r /tmp/backend-requirements.txt \
    -r /tmp/gis-requirements.txt \
    pandas pdfplumber cloudscraper uvicorn[standard] playwright && \
    playwright install chromium

# Copy application code
COPY . /app/

# Timezone: Asia/Karachi
ENV TZ=Asia/Karachi
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

EXPOSE 5000 8000 8001

CMD ["python", "proxy.py"]
